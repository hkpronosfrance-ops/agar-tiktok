# Pseudo TikTok à écouter (sans le @), doit être EN LIVE pour que ça fonctionne
TIKTOK_USERNAME=

# Depuis Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Durée d'une manche en secondes (300 = 5 minutes)
ROUND_SECONDS=300

# Clé API gratuite sur https://www.eulerstream.com (nécessaire pour signer les
# requêtes vers TikTok — sans elle, la connexion échoue avec "Failed to sign request")
EULER_SIGN_API_KEY=
