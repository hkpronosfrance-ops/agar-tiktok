# Pseudo TikTok à écouter (sans le @), doit être EN LIVE pour que ça fonctionne
TIKTOK_USERNAME=

# Depuis Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Durée d'une manche en secondes (150 = 2 min 30)
ROUND_SECONDS=150

# Durée d'affichage du podium + classement général après chaque manche (secondes)
PODIUM_SECONDS=18

# Durée de l'écran règles + compte à rebours avant la manche suivante (secondes)
RULES_SECONDS=12

# Clé API gratuite sur https://www.eulerstream.com (nécessaire pour signer les
# requêtes vers TikTok — sans elle, la connexion échoue avec "Failed to sign request")
EULER_SIGN_API_KEY=
